{
    "name": "devletes/filament-time-picker",
    "description": "A clock-face time and date-time picker for Filament — hour and minute dials, drag or type, natively in Livewire and Alpine. No jQuery, no date library, no build step.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "livewire",
        "alpine",
        "time-picker",
        "timepicker",
        "date-time-picker",
        "clock",
        "clock-picker",
        "dial",
        "form-component"
    ],
    "authors": [
        {
            "name": "Devletes",
            "email": "packages@devletes.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Devletes\\TimePicker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Devletes\\TimePicker\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "filament-assets": "@php vendor/orchestra/testbench-core/laravel/artisan filament:assets --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@filament-assets",
            "@php vendor/bin/testbench serve --port=8766 --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Devletes\\TimePicker\\TimePickerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://github.com/devletes/filament-time-picker",
    "support": {
        "issues": "https://github.com/devletes/filament-time-picker/issues",
        "source": "https://github.com/devletes/filament-time-picker"
    }
}
